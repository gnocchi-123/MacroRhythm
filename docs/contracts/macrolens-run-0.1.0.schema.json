{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MacroRhythm MacroLens run exchange draft 0.1.0",
  "description": "R0 proposal only. No exporter or runtime consumer is implemented.",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "0.1.0"
    },
    "artifact_kind": {
      "const": "macrolens.run"
    },
    "exported_at": {
      "type": "string",
      "format": "date-time"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "repository": {
          "const": "gnocchi-123/MacroLens"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "repository",
        "manifest_sha256"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 2
        },
        "engine_version": {
          "enum": [
            "m2-v1",
            "m3-v1"
          ]
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "kind": {
          "enum": [
            "original",
            "correction",
            "rerun",
            "replay"
          ]
        },
        "parent_run_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "previous_run_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "enum": [
            "sample",
            "fred"
          ]
        },
        "model_version": {
          "enum": [
            "demo-v1",
            "macro-sector-hypothesis-v1"
          ]
        },
        "model_purpose": {
          "type": "string",
          "minLength": 1
        },
        "validation_status": {
          "const": "미검증 연구용"
        },
        "status": {
          "enum": [
            "demo_complete",
            "research_complete",
            "held"
          ]
        },
        "strict_point_in_time": {
          "const": false
        },
        "time_policy": {
          "enum": [
            "synthetic-v1",
            "collected-at-v1",
            "chicago-prior-day-v1"
          ]
        },
        "point_in_time_status": {
          "enum": [
            "synthetic",
            "collected_inputs_only",
            "date_only_conservative"
          ]
        },
        "week_slot": {
          "type": "string",
          "format": "date"
        },
        "config_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "snapshot_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "commit_sha": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "working_tree_dirty": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "indicators": {
          "type": "object",
          "properties": {
            "INDPRO": {
              "$ref": "#/$defs/indicator"
            },
            "UNRATE": {
              "$ref": "#/$defs/indicator"
            },
            "CPIAUCSL": {
              "$ref": "#/$defs/indicator"
            },
            "DGS10": {
              "$ref": "#/$defs/indicator"
            }
          },
          "required": [
            "INDPRO",
            "UNRATE",
            "CPIAUCSL",
            "DGS10"
          ],
          "additionalProperties": false
        },
        "factors": {
          "type": "object",
          "properties": {
            "growth": {
              "$ref": "#/$defs/indicator"
            },
            "employment": {
              "$ref": "#/$defs/indicator"
            },
            "inflation": {
              "$ref": "#/$defs/indicator"
            },
            "rates": {
              "$ref": "#/$defs/indicator"
            }
          },
          "required": [
            "growth",
            "employment",
            "inflation",
            "rates"
          ],
          "additionalProperties": false
        },
        "scores": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sector": {
                "type": "string",
                "minLength": 1
              },
              "rank": {
                "type": "number",
                "minimum": 1
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "contributions": {
                "type": "object",
                "properties": {
                  "growth": {
                    "type": "number"
                  },
                  "employment": {
                    "type": "number"
                  },
                  "inflation": {
                    "type": "number"
                  },
                  "rates": {
                    "type": "number"
                  }
                },
                "required": [
                  "growth",
                  "employment",
                  "inflation",
                  "rates"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "sector",
              "rank",
              "score",
              "contributions"
            ],
            "additionalProperties": true
          }
        },
        "history": {
          "type": "object",
          "properties": {
            "week_slot": {
              "type": "string",
              "format": "date"
            },
            "previous_slot": {
              "type": "string",
              "format": "date"
            },
            "selection_rule": {
              "type": "string",
              "minLength": 1
            },
            "previous_week": {
              "anyOf": [
                {
                  "$ref": "#/$defs/comparison"
                },
                {
                  "type": "null"
                }
              ]
            },
            "last_available": {
              "anyOf": [
                {
                  "$ref": "#/$defs/comparison"
                },
                {
                  "type": "null"
                }
              ]
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "week_slot",
            "previous_slot",
            "selection_rule",
            "previous_week",
            "last_available",
            "warnings"
          ],
          "additionalProperties": true
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "schema_version",
        "engine_version",
        "run_id",
        "as_of",
        "generated_at",
        "kind",
        "parent_run_id",
        "previous_run_id",
        "mode",
        "model_version",
        "model_purpose",
        "validation_status",
        "status",
        "strict_point_in_time",
        "time_policy",
        "point_in_time_status",
        "week_slot",
        "config_hash",
        "snapshot_hash",
        "input_hash",
        "commit_sha",
        "working_tree_dirty",
        "indicators",
        "factors",
        "scores",
        "history",
        "limitations"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "held"
              }
            }
          },
          "then": {
            "properties": {
              "scores": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "scores": {
                "minItems": 1
              },
              "indicators": {
                "properties": {
                  "INDPRO": {
                    "$ref": "#/$defs/validIndicator"
                  },
                  "UNRATE": {
                    "$ref": "#/$defs/validIndicator"
                  },
                  "CPIAUCSL": {
                    "$ref": "#/$defs/validIndicator"
                  },
                  "DGS10": {
                    "$ref": "#/$defs/validIndicator"
                  }
                }
              },
              "factors": {
                "properties": {
                  "growth": {
                    "$ref": "#/$defs/validIndicator"
                  },
                  "employment": {
                    "$ref": "#/$defs/validIndicator"
                  },
                  "inflation": {
                    "$ref": "#/$defs/validIndicator"
                  },
                  "rates": {
                    "$ref": "#/$defs/validIndicator"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "sample"
              }
            }
          },
          "then": {
            "properties": {
              "time_policy": {
                "const": "synthetic-v1"
              },
              "point_in_time_status": {
                "const": "synthetic"
              }
            }
          },
          "else": {
            "properties": {
              "time_policy": {
                "enum": [
                  "collected-at-v1",
                  "chicago-prior-day-v1"
                ]
              },
              "point_in_time_status": {
                "enum": [
                  "collected_inputs_only",
                  "date_only_conservative"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "engine_version": {
                "const": "m3-v1"
              }
            }
          },
          "then": {
            "required": [
              "model_kind",
              "model_status",
              "model_frozen_at",
              "rationale_document",
              "ranking_policy"
            ],
            "properties": {
              "model_kind": {
                "const": "research"
              },
              "model_status": {
                "const": "frozen"
              },
              "model_frozen_at": {
                "type": "string",
                "format": "date-time"
              },
              "rationale_document": {
                "type": "string",
                "minLength": 1
              },
              "ranking_policy": {
                "const": "average"
              },
              "model_version": {
                "const": "macro-sector-hypothesis-v1"
              },
              "status": {
                "enum": [
                  "research_complete",
                  "held"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "model_version": {
                "const": "demo-v1"
              },
              "status": {
                "enum": [
                  "demo_complete",
                  "held"
                ]
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "contract_version",
    "artifact_kind",
    "exported_at",
    "provenance",
    "result"
  ],
  "additionalProperties": false,
  "$defs": {
    "indicator": {
      "oneOf": [
        {
          "$ref": "#/$defs/validIndicator"
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "held"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "reason"
          ],
          "additionalProperties": true
        }
      ]
    },
    "validIndicator": {
      "type": "object",
      "properties": {
        "status": {
          "const": "valid"
        },
        "raw_value": {
          "type": "number"
        },
        "transformed_value": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "value": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "mean": {
          "type": "number"
        },
        "std": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "window": {
          "type": "integer",
          "minimum": 2
        },
        "transform": {
          "enum": [
            "yoy",
            "negative_3m",
            "difference_28d"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "availability_policy": {
          "type": "string",
          "minLength": 1
        },
        "observation": {
          "type": "object",
          "properties": {
            "observation_date": {
              "type": "string",
              "format": "date"
            },
            "value": {
              "type": "number"
            },
            "published_at": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "available_at": {
              "type": "string",
              "format": "date-time"
            },
            "retrieved_at": {
              "type": "string",
              "format": "date-time"
            },
            "vintage_date": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "observation_date",
            "value",
            "published_at",
            "available_at",
            "retrieved_at",
            "vintage_date"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "status",
        "raw_value",
        "transformed_value",
        "z",
        "value",
        "mean",
        "std",
        "window",
        "transform",
        "source",
        "availability_policy",
        "observation"
      ],
      "additionalProperties": true
    },
    "comparison": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "comparable",
            "not_comparable"
          ]
        },
        "before_run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "after_run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "indicators": {
          "type": "object"
        },
        "factors": {
          "type": "object"
        },
        "sectors": {
          "type": "object"
        }
      },
      "required": [
        "status",
        "before_run_id",
        "after_run_id",
        "reasons",
        "indicators",
        "factors",
        "sectors"
      ],
      "additionalProperties": true
    }
  }
}
